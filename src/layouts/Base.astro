---
import '../styles/global.css';
import { SITE, localePath, type Lang } from '../site';
import { useT } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path without the language prefix, e.g. '/' or '/app/financer/'. */
  path: string;
  jsonLd?: object;
  noindex?: boolean;
  query?: string;
}

const { lang, title, description, path, jsonLd, noindex = false, query = '' } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'en' ? 'cs' : 'en';
const canonical = new URL(localePath(lang, path), SITE.url).href;
const alternate = (l: Lang) => new URL(localePath(l, path), SITE.url).href;
const pageTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex && <link rel="alternate" hreflang="en" href={alternate('en')} />}
    {!noindex && <link rel="alternate" hreflang="cs" href={alternate('cs')} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={alternate('en')} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f5f6fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1016" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'cs' ? 'cs_CZ' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Instrument+Sans:wght@400..600&display=swap"
    />
    <link rel="preconnect" href="https://api.github.com" crossorigin />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href={localePath(lang)}>
          <img src="/favicon.svg" alt="" width="28" height="28" />
          <span>{SITE.name}</span>
        </a>
        <form class="search" role="search" action={localePath(lang)} method="get">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"
            ><path
              fill="currentColor"
              d="M10 4a6 6 0 1 0 3.75 10.69l4.28 4.28 1.41-1.41-4.28-4.28A6 6 0 0 0 10 4Zm0 2a4 4 0 1 1 0 8 4 4 0 0 1 0-8Z"
            ></path></svg
          >
          <label class="sr-only" for="q">{t('search.label')}</label>
          <input id="q" name="q" type="search" placeholder={t('search.placeholder')} value={query} autocomplete="off" />
        </form>
        <a class="lang" href={localePath(other, path)} hreflang={other} lang={other}>{t('lang.switch')}</a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {SITE.author}</span>
        <span>{t('footer.source')}</span>
        <a href={SITE.github} rel="me">GitHub</a>
      </div>
    </footer>
  </body>
</html>

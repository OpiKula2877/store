---
import Base from '../layouts/Base.astro';
import AppIcon from '../components/AppIcon.astro';
import { SITE, localePath, type App, type Lang } from '../site';
import { useT } from '../i18n/ui';

interface Props {
  lang: Lang;
  app: App;
}

const { lang, app } = Astro.props;
const t = useT(lang);
const pageUrl = new URL(localePath(lang, `/app/${app.slug}/`), SITE.url).href;
const description = app.description ?? t('app.metaDescription', { name: app.name });

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: app.name,
      url: pageUrl,
      description,
      applicationCategory: 'Application',
      author: { '@type': 'Person', name: SITE.author, url: SITE.github },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      sameAs: app.url,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: SITE.name, item: new URL(localePath(lang), SITE.url).href },
        { '@type': 'ListItem', position: 2, name: app.name, item: pageUrl },
      ],
    },
  ],
};
---

<Base lang={lang} title={app.name} description={description} path={`/app/${app.slug}/`} jsonLd={jsonLd}>
  <article
    class="detail wrap"
    data-app
    data-owner={app.owner}
    data-repo={app.repo}
    data-name={app.name}
    data-description={app.description ?? ''}
    data-declared={app.platforms.join(' ')}
  >
    <a class="back" href={localePath(lang)}>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M15.4 6.4 14 5l-7 7 7 7 1.4-1.4L9.8 12z"></path></svg>
      {t('app.back')}
    </a>

    <header class="detail-head">
      <AppIcon app={app} size={120} class="detail-icon" />
      <div class="detail-title">
        <h1>{app.name}</h1>
        <a class="author" href={SITE.github}>{t('app.by', { author: SITE.author })}</a>
        <p class="detail-desc" data-field="desc">
          {app.description ?? <span class="skeleton" style="width:70%" />}
        </p>
      </div>
    </header>

    <dl class="stats" data-stats>
      <div><dt>{t('app.version')}</dt><dd data-stat="version"><span class="skeleton" /></dd></div>
      <div><dt>{t('app.downloads')}</dt><dd data-stat="downloads"><span class="skeleton" /></dd></div>
      <div><dt>{t('app.stars')}</dt><dd data-stat="stars"><span class="skeleton" /></dd></div>
      <div><dt>{t('app.updated')}</dt><dd data-stat="updated"><span class="skeleton" /></dd></div>
      <div data-stat-wrap="license" hidden><dt>{t('app.license')}</dt><dd data-stat="license"></dd></div>
    </dl>

    <p class="notice" data-notice hidden></p>

    <section class="get" aria-label={t('app.download')}>
      <div class="get-row">
        <label class="version-pick" data-version-wrap hidden>
          <span>{t('app.chooseVersion')}</span>
          <select data-version></select>
        </label>
        <div class="get-actions" data-primary></div>
      </div>
      <div class="support-row" data-support-row hidden>
        <span class="support-label">{t('app.support')}</span>
        <ul class="support" data-support></ul>
      </div>
      <p class="get-hint" data-hint hidden></p>
      <div class="get-links">
        <a class="btn btn-quiet" data-website hidden target="_blank" rel="noopener">{t('app.openWebsite')}</a>
        <a class="btn btn-quiet" href={app.url} target="_blank" rel="noopener">{t('app.viewSource')}</a>
      </div>
    </section>

    <section class="shots" data-shots hidden aria-label={t('app.tabScreenshots')}>
      <ul data-shots-list></ul>
    </section>

    <div class="detail-body">
      <div class="detail-main">
        <div class="tabs" role="tablist">
          <button type="button" role="tab" id="tab-about" aria-controls="panel-about" aria-selected="true">{t('app.tabAbout')}</button>
          <button type="button" role="tab" id="tab-changelog" aria-controls="panel-changelog" aria-selected="false" tabindex="-1"
            >{t('app.tabChangelog')}</button
          >
        </div>
        <div role="tabpanel" id="panel-about" aria-labelledby="tab-about" class="prose" data-readme>
          <span class="skeleton" style="width:90%"></span>
          <span class="skeleton" style="width:75%"></span>
          <span class="skeleton" style="width:82%"></span>
        </div>
        <div role="tabpanel" id="panel-changelog" aria-labelledby="tab-changelog" data-changelog hidden></div>
      </div>

      <aside class="detail-side" data-side hidden>
        <section>
          <h2 data-notes-title></h2>
          <p class="released" data-released></p>
          <div class="prose prose-small" data-notes></div>
        </section>
        <section>
          <h2>{t('app.otherFiles')}</h2>
          <ul class="files" data-files></ul>
        </section>
      </aside>
    </div>
  </article>

  <dialog class="lightbox" data-lightbox>
    <form method="dialog"><button class="lb-close" aria-label={t('app.close')}>×</button></form>
    <button type="button" class="lb-nav lb-prev" data-lb-prev aria-label={t('app.prev')}>‹</button>
    <img alt="" data-lb-img />
    <button type="button" class="lb-nav lb-next" data-lb-next aria-label={t('app.next')}>›</button>
  </dialog>
</Base>

<script>
  import '../scripts/app';
</script>
